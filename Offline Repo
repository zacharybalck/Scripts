#!/bin/bash
#
# Script Name: Offline Repo Setup & Maintenance
# Description: Configures a local YUM repository, applies offline updates, 
#              resets specified passwords, cleans caches, and clears history.
#

# Exit immediately if a command exits with a non-status zero (optional, comment out if you want strict non-stop behavior)
# set -e

# Ensure script is run as root
if [[ $EUID -ne 0 ]]; then
    echo "[ERROR]: This script must be run as root." >&2
    exit 1
fi

echo "=========================================="
echo " Starting Task 1: Building Offline Repo"
echo "=========================================="

REPO_FILE="/etc/yum.repos.d/offline.repo"
REPO_PATH="/tmp/usb/temprepo"

if [[ ! -d "$REPO_PATH" ]]; then
    echo "[WARNING]: Repository path $REPO_PATH does not exist. Ensure your USB/repo source is mounted."
fi

# Creates the repo file in /etc/yum.repos.d/
cat > "$REPO_FILE" << EOF
[offline]
name=Offline Repository
baseurl=file://$REPO_PATH
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release
enabled=1
gpgcheck=0
repo_gpgcheck=0
priority=1
EOF

echo "[INFO]: Cleaning package manager cache..."
yum clean all

echo ""
echo "=========================================="
echo " Starting Task 2: Applying Updates"
echo "=========================================="

# Apply updates from the offline repository automatically (-y)
yum update --disablerepo=* --enablerepo=offline -y

echo ""
echo "=========================================="
echo " Starting Task 3: Restoring System Settings"
echo "=========================================="

# Reset root password
echo "[INFO]: Resetting Root Password..."
passwd root

# Reset SSH account password only if the user exists
if id "sshaccount" &>/dev/null; then
    echo "[INFO]: Resetting SSH Account Password for 'sshaccount'..."
    passwd sshaccount
else
    echo "[WARNING]: User 'sshaccount' does not exist. Skipping password reset."
fi

# Remove temporary files from home directories safely
echo "[INFO]: Removing temporary files and caches..."
rm -rf /home/*/.cache /home/*/.local/share/Trash 2>/dev/null || true

# Clear history and screen history
echo "[INFO]: Clearing terminal history..."
history -c
history -w
rm -f /root/.bash_history
rm -f /home/*/.bash_history

echo ""
echo "=========================================="
echo " Maintenance Complete!"
echo "=========================================="

# Reboot prompt loop
while true; do
    read -p "Do you want to reboot the server now? (y/n) " yn
    case $yn in
        [Yy]* ) 
            echo "[INFO]: Rebooting system..."
            reboot
            break
            ;;
        [Nn]* ) 
            echo "[INFO]: Reboot skipped. Remember to reboot manually."
            exit 0
            ;;
        * ) 
            echo "Please answer yes or no."
            ;;
    esac
done
