function Invoke-RobocopyWithProgress {
    [CmdletBinding()]
    param (
        [Parameter(Mandatory = $true)]
        [ValidateScript({ Test-Path $_ -PathType Container })]
        [string]$Source,

        [Parameter(Mandatory = $true)]
        [string]$Destination,

        [string]$CustomOptions = "/E /Z /R:3 /W:5 /MT:8"
    )

    process {
        Write-Host "[INFO] Analyzing source and calculating totals..." -ForegroundColor Cyan

        # Step 1: Perform a quick dry-run (/L) with /BYTES to get total files and bytes instantly
        $dryRunArgs = @("`"$Source`"", "`"$Destination`"", "/L", "/BYTES", "/NJH", "/NJS", "/NC", "/NS", "/NP")
        $dryRunOutput = & robocopy @dryRunArgs 2>&1

        # Extract total bytes and files from Robocopy summary
        $totalBytes = 0
        $totalFiles = 0

        foreach ($line in $dryRunOutput) {
            if ($line -match "Bytes\s*:\s*([\d\.]+)") {
                # Robocopy sometimes outputs "Bytes : X (or Y)" or just numbers
                $matchesVal = [regex]::Matches($line, "Bytes\s*:\s*(\d+)")
                if ($matchesVal.Count -gt 0) {
                    $totalBytes = [long]$matchesVal[0].Groups[1].Value
                }
            }
            if ($line -match "Files\s*:\s*(\d+)") {
                $matchesFiles = [regex]::Matches($line, "Files\s*:\s*(\d+)")
                if ($matchesFiles.Count -gt 0) {
                    $totalFiles = [int]$matchesFiles[0].Groups[1].Value
                }
            }
        }

        if ($totalBytes -eq 0) {
            Write-Host "[WARNING] Could not determine total byte size. Progress percentage may be estimated." -ForegroundColor Yellow
            $totalBytes = 1 # Prevent division by zero
        }

        Write-Host "[INFO] Total Files: $totalFiles | Total Size: $([math]::Round($totalBytes / 1MB, 2)) MB" -ForegroundColor Green
        Write-Host "[INFO] Starting file transfer..." -ForegroundColor Cyan

        # Step 2: Run the actual Robocopy operation and stream output
        $robocopyArgs = $Source, $Destination, "/MIR", "/BYTES", "/NP", "/ETA"
        # Split custom options safely and build argument list
        $optionList = $CustomOptions -split '\s+'

        # We invoke robocopy and capture line-by-line output
        $processInfo = New-Object System.Diagnostics.ProcessStartInfo
        $processInfo.FileName = "robocopy.exe"
        $processInfo.Arguments = "`"$Source`" `"$Destination`" /MIR /BYTES /NP /ETA " + $CustomOptions
        $processInfo.RedirectStandardOutput = $true
        $processInfo.UseShellExecute = $false
        $processInfo.CreateNoWindow = $true

        $process = [System.Diagnostics.Process]::Start($processInfo)
        
        $bytesProcessed = 0
        
        while (-not $process.StandardOutput.EndOfStream) {
            $line = $process.StandardOutput.ReadLine()
            
            # Parse progress lines (Robocopy prints percentage lines like "  45%  ")
            if ($line -match "^\s*(\d+)%\s+") {
                $percent = [int]$Matches[1]
                
                Write-Progress -Activity "Copying files from $Source to Destination" `
                               -Status "$percent% Complete" `
                               -PercentComplete $percent `
                               -CurrentOperation "Copying in progress..."
            }
        }

        $process.WaitForExit()
        $exitCode = $process.ExitCode

        # Clear progress bar
        Write-Progress -Activity "Copying files from $Source to Destination" -Completed

        # Robocopy exit codes 0-7 are success/warnings, 8+ are actual failures
        if ($exitCode -ge 8) {
            Write-Host "[ERROR] Robocopy encountered errors during execution. Exit code: $exitCode" -ForegroundColor Red
            return $false
        } else {
            Write-Host "[SUCCESS] Copy completed successfully! (Exit code: $exitCode)" -ForegroundColor Green
            return $true
        }
    }
}
